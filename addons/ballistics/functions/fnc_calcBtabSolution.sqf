#include "..\script_component.hpp"

/*
 * Author: ToadBall, Yax, VKing
 * Computes the firing solution for one charge from its ballistic table (as generated by tables\calcBallistics.sqf)
 * for a given horizontal distance and height difference between gun and target. Every table is computed without
 * air friction, so the solution is the exact vacuum trajectory; the table only provides the charge's muzzle velocity
 * and the elevation range it covers. A table starting at 45 degrees or more is for high-angle fire and gives the high
 * solution, any other table the low one. Returns an empty array if the target is out of reach or the solution lies
 * outside the table's elevation range.
 *
 * Arguments:
 * 0: Ballistic table for a single charge: [table, rangeMin, rangeMax, heightMin, heightMax, heightStep] <ARRAY>
 * 1: Horizontal distance from gun to target <NUMBER>
 * 2: Height difference between target and gun <NUMBER>
 *
 * Return Value:
 * Firing solution [gunElevationMils, timeOfFlight, impactVelocity, impactAngle, maxOrdinate, distance, height], or [] if none <ARRAY>
 *
 * Example:
 * [_atab, 4500, 120] call itc_land_ballistics_fnc_calcBtabSolution
 *
 * Public: No
 */

params ["_atab", "_distance", "_heightDelta"];
private _table = _atab # 0;

// The gravity the tables were generated with (ACE's GRAVITY macro is rounded to 9.8066)
#define BTAB_GRAVITY 9.80665

// Rows are [elevation, maximum ordinate, [[distance, height, time, speed, flight angle], ...]]
private _elevMin = _table # 0 # 0;
private _elevMax = (_table select -1) # 0;

// Muzzle velocity: without air friction the horizontal speed stays constant, so any recorded point of a row gives it.
// The row closest to horizontal gives it most precisely.
private _velocity = 0;
private _bestCos = 0;
{
    _x params ["_elev", "", "_slices"];
    if (_slices isNotEqualTo [] && {cos _elev > _bestCos}) then {
        _bestCos = cos _elev;
        (_slices # 0) params ["", "", "", "_speed", "_angle"];
        _velocity = _speed * cos _angle / _bestCos;
    };
} forEach _table;

if (_distance < 1 || {_velocity <= 0}) exitWith {[]};

private _v2 = _velocity ^ 2;
private _root = _v2 ^ 2 - BTAB_GRAVITY * (BTAB_GRAVITY * _distance ^ 2 + 2 * _heightDelta * _v2);
if (_root < 0) exitWith {[]};
_root = sqrt _root;

// tan q = (v^2 -/+ root) / (g R); the low root in the form that doesn't cancel out for fast shells
private _tanElevation = if (_elevMin >= 45) then {
    (_v2 + _root) / (BTAB_GRAVITY * _distance)
} else {
    (BTAB_GRAVITY * _distance ^ 2 + 2 * _heightDelta * _v2) / (_distance * (_v2 + _root))
};
private _elevation = atan _tanElevation;
if (_elevation < _elevMin || {_elevation > _elevMax}) exitWith {[]};

private _vx = _velocity * cos _elevation;
private _vy = _velocity * sin _elevation;
private _timeOfFlight = _distance / _vx;
private _impactVy = _vy - BTAB_GRAVITY * _timeOfFlight;
private _impactVelocity = sqrt (_vx ^ 2 + _impactVy ^ 2);
private _impactAngle = _impactVy atan2 _vx;
// still climbing at the target: the highest point is the target itself
private _maxOrdinate = if (_impactVy >= 0) then {_heightDelta} else {(_vy max 0) ^ 2 / (2 * BTAB_GRAVITY)};

[round (_elevation * 6400 / 360), _timeOfFlight, _impactVelocity, _impactAngle, _maxOrdinate, _distance, _heightDelta]
